# Backend NhaCarro
PORT=3001
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Server-only auth client key. Prefer the current publishable key; anon is accepted for compatibility.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=

# Comma-separated browser origins allowed by CORS. Leave empty for native/mobile-only API.
CORS_ORIGINS=

# Transactional email / password recovery
RESEND_API_KEY=
EMAIL_FROM=
PASSWORD_RESET_URL=https://nha-carro.onrender.com/reset-password
