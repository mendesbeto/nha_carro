# Backend NhaCarro
PORT=3001
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Use a long random secret in production. Never commit the real value.
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=1h

# Comma-separated browser origins allowed by CORS. Leave empty for native/mobile-only API.
CORS_ORIGINS=

# Transactional email / password recovery
RESEND_API_KEY=
EMAIL_FROM=
# Trusted HTTPS URL of the password-reset page/app entry point.
PASSWORD_RESET_URL=https://nha-carro.onrender.com/reset-password
